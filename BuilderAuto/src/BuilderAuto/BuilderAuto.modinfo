<?xml version="1.0" encoding="utf-8"?>
<Mod id="a1c278f8-20bc-4fbb-b0bd-6b121c0d0342" version="1">
  <Properties>
    <Name>建造者自动作业 / Builder Auto</Name>
    <Description>逐个建造者开关：修复、开发资源、改良工作地块。遇敌暂停，手动操作接管。</Description>
    <Authors>xuanda0201</Authors>
    <AffectsSavedGames>1</AffectsSavedGames>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>0</SupportsMultiplayer>
    <SupportsHotSeat>0</SupportsHotSeat>
  </Properties>
  <InGameActions>
    <AddGameplayScripts id="BA_State"><File>BuilderAuto_State.lua</File></AddGameplayScripts>
    <AddUserInterfaces id="BA_UI">
      <Properties><Context>InGame</Context><LoadOrder>20000</LoadOrder></Properties>
      <File>BuilderAuto.xml</File>
    </AddUserInterfaces>
    <ImportFiles id="BA_Files">
      <File>BuilderAuto.lua</File><File>BuilderAuto_Common.lua</File><File>BuilderAuto_Rules.lua</File>
    </ImportFiles>
    <UpdateText id="BA_Text"><File>Text.xml</File></UpdateText>
  </InGameActions>
  <Files>
    <File>BuilderAuto_State.lua</File><File>BuilderAuto_Common.lua</File>
    <File>BuilderAuto_Rules.lua</File><File>BuilderAuto.lua</File>
    <File>BuilderAuto.xml</File><File>Text.xml</File>
    <File>LICENSE.txt</File>
  </Files>
</Mod>
